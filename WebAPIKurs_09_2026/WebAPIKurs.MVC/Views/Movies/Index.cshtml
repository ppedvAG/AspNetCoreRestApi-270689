@using WebAPIKurs.Shared.Entities
@model List<Movie>

    

@{
    ViewData["Title"] = "Movies";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Neuen Film erstellen</a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        Keine Filme vorhanden.
    </div>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Titel</th>
                <th>Beschreibung</th>
                <th>Preis</th>
                <th>Jahr</th>
                <th>Genre</th>
                <th>Aktionen</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var movie in Model)
            {
                <tr>
                    <td>@movie.Title</td>
                    <td>@movie.Description</td>
                    <td>@movie.Price €</td>
                    <td>@movie.Year</td>
                    <td>@movie.Genre</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-sm btn-info">Anzeigen</a>
                        <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-warning">Bearbeiten</a>
                        <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-sm btn-danger">Löschen</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}